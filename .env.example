# Google Gemini API Key
# Get your free API key at: https://aistudio.google.com/app/apikey
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# AI Model for Document Transcription & OCR
# Recommended Options:
# 1. gemini-1.5-flash-8b (FASTEST - ultra-low latency, built for quick text extraction)
# 2. gemini-1.5-flash    (DEFAULT - high accuracy on complex documents, tables & handwriting)
# 3. gemini-2.0-flash    (Next-generation Flash model)
EXPO_PUBLIC_GEMINI_MODEL=gemini-1.5-flash-8b
