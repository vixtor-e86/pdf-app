# Google Gemini API Key
# Get your free API key at: https://aistudio.google.com/app/apikey
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# AI Model for Document Transcription & OCR
# Recommended Options:
# 1. gemini-flash-lite-latest (FASTEST - official Google low-latency multimodal model)
# 2. gemini-flash-latest      (DEFAULT - high-accuracy balanced multimodal model)
# 3. gemini-3.5-flash-lite    (Next-gen Flash Lite)
EXPO_PUBLIC_GEMINI_MODEL=gemini-flash-lite-latest
